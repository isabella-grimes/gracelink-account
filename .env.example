# G.R.A.C.E accounts platform settings. Copy to .env (install.sh does this for you).

# Your platform domain. Tenants get <name>.<PLATFORM_DOMAIN>, e.g. acme.graceaccounts.sa
# Point a wildcard DNS record (*.graceaccounts.sa) at this server.
PLATFORM_DOMAIN=graceaccounts.sa

# Email for Let's Encrypt certificate notices
LETSENCRYPT_EMAIL=admin@graceaccounts.sa

# true  = HTTPS with free Let's Encrypt certificates (production)
# false = plain HTTP (local testing, or when another proxy terminates SSL)
TLS=true

# MariaDB root password. install.sh generates a strong one. Never change it after install.
DB_ROOT_PASSWORD=

# App image. build.sh builds it locally; or set to a registry image, e.g.
# GRACE_IMAGE=ghcr.io/isabella-grimes/grace-accounts and PULL_POLICY=always
GRACE_IMAGE=grace-accounts
GRACE_TAG=16
PULL_POLICY=missing

# Ports (change only if 80/443 are taken)
HTTP_PORT=80
HTTPS_PORT=443

# Capacity. Rough guide: 2 workers per CPU core. 4 workers + 1G buffer pool
# comfortably serves dozens of small tenants on a 4 vCPU / 8 GB server.
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
DB_BUFFER_POOL=1G

# Default plan for new tenants: economic | basic | comprehensive
DEFAULT_PLAN=basic
