# GraceERP Solution platform settings. Copy to .env (install.sh does this for you).

# Your platform domain. Tenants get <name>.<PLATFORM_DOMAIN>, e.g. acme.erp.gracelinkgroup.com
# Point a wildcard DNS record (*.erp.gracelinkgroup.com) at this server.
PLATFORM_DOMAIN=erp.gracelinkgroup.com

# Email for Let's Encrypt certificate notices
LETSENCRYPT_EMAIL=admin@gracelinkgroup.com

# Where customers get help: shown in every tenant's Help menu and About dialog.
# A WhatsApp link, website or email, e.g. https://wa.me/9665XXXXXXXX or mailto:support@gracelinkgroup.com
SUPPORT_URL=mailto:support@gracelinkgroup.com

# true  = HTTPS with free Let's Encrypt certificates (production)
# false = plain HTTP (local testing, or when another proxy terminates SSL)
TLS=true

# MariaDB root password. install.sh generates a strong one. Never change it after install.
DB_ROOT_PASSWORD=

# App image. build.sh builds it locally; or set to a registry image, e.g.
# GRACE_IMAGE=ghcr.io/isabella-grimes/grace-accounts and PULL_POLICY=always
GRACE_IMAGE=grace-accounts
GRACE_TAG=16
PULL_POLICY=missing

# Only needed when apps.json marks an app repository "private": true and you build the image
# on this server (build.sh): a GitHub token that can read it (fine-grained, "Contents:
# Read-only"). Not needed for public repositories or when you pull the image from ghcr.io.
GRACE_REPO_TOKEN=

# Optional: one Anthropic API key for every hosted tenant (Ask GRACE and Smart Import's AI
# column mapping). Each tenant still has AI off until its administrator turns it on in
# Grace AI Settings, which also sets its monthly and daily token limits.
ANTHROPIC_API_KEY=

# Ports (change only if 80/443 are taken)
HTTP_PORT=80
HTTPS_PORT=443

# Capacity. Rough guide: 2 workers per CPU core. 4 workers + 1G buffer pool
# comfortably serves dozens of small tenants on a 4 vCPU / 8 GB server.
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
DB_BUFFER_POOL=1G

# Default plan for new tenants: economic | basic | comprehensive
DEFAULT_PLAN=basic
